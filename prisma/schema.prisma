generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  PENDING
  CUSTOMER
  TECHNICIAN
  VENDOR
  SUPER_ADMIN
}

model User {
  id                String             @id @default(cuid())
  name              String?
  email             String?            @unique
  emailVerified     DateTime?
  image             String?
  password          String?
  // Globally unique across every role — OTP login looks accounts up by
  // phone, so a phone number can only ever belong to one account, whichever
  // role it registered under first.
  phone             String?            @unique
  // Technician-only login handle (self-chosen at signup, or auto-generated
  // when a vendor creates the account). Null for every other role.
  username          String?            @unique
  role              Role               @default(PENDING)
  // Customer-only: two fixed 4-digit PINs the customer reads out — one to
  // let a technician start a job, a different one to let them close it, so
  // knowing the start PIN never lets anyone mark work complete. Generated
  // lazily on their first order. Never sent to a technician's device — they
  // submit a candidate and the server compares.
  startPin          String?
  completionPin     String?
  accounts          Account[]
  sessions          Session[]
  cartItems         CartItem[]
  vendorProfile     VendorProfile?
  technicianProfile TechnicianProfile?
  wallet            CustomerWallet?
  liveCalls         LiveCall[]
  serviceCalls      ServiceCall[]
  notifications     Notification[]
  addresses         Address[]
  chatMessages      ChatMessage[]
  reviews           Review[]
  supportTicketMessages SupportTicketMessage[]
}

// A customer's saved delivery location — Blinkit/Zomato-style address book.
// Not referenced by a foreign key from LiveCall: checkout snapshots the
// chosen address's fields into LiveCall directly (same pattern already used
// for customer contact fields), so editing/deleting a saved address here
// never changes a past order's record.
model Address {
  id          String   @id @default(cuid())
  customerId  String
  customer    User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // Free text, customer-chosen — "Home"/"Work"/"Other" are just quick-pick
  // suggestions in the UI, not an enum.
  label       String
  addressLine String
  city        String
  state       String
  pincode     String
  latitude    Float
  longitude   Float
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([customerId])
}

// Company type is a free-form string (not an enum) so new legal structures
// don't require a schema migration — the onboarding form offers a fixed
// dropdown of common values, but the column itself stays flexible.
model VendorProfile {
  id                String              @id @default(cuid())
  userId            String              @unique
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName       String
  companyType       String
  // Optional at onboarding — a vendor can start operating and add these
  // later. No @unique on any of the three, so relaxing to nullable is a
  // pure widening with no migration hazard.
  gstNumber         String?
  panNumber         String?
  aadhaarNumber     String?
  address           String
  city              String
  state             String
  pincode           String
  // Business location — captured via "use current location" at onboarding.
  // Nullable because vendors who onboarded before this field existed won't
  // have it set; matching logic must treat null as "not yet locatable".
  latitude          Float?
  longitude         Float?
  // Deactivated vendors keep their account and history intact but stop
  // receiving new live-call broadcasts — the safe alternative to deleting a
  // vendor outright, which would cascade-delete their ServiceCall history.
  isActive          Boolean             @default(true)
  incorporationDate DateTime
  // Admin-set, per vendor — how much buying a live-call lead costs this
  // specific vendor. Deliberately not a platform-wide constant: a
  // struggling new vendor can be priced differently than an established
  // one. ₹49 flat is the default applied at creation, never "free".
  leadPricingType   LeadPricingType     @default(FLAT)
  leadPricingValue  Float               @default(49)
  wallet            VendorWallet?
  technicians       TechnicianProfile[]
  liveCallsAccepted LiveCall[]
  serviceCalls      ServiceCall[]
  serviceCallOffers ServiceCallOffer[]
  serviceAreas      VendorServiceArea[]
  categories        VendorCategory[]
  supportTickets    SupportTicket[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

enum LeadPricingType {
  FLAT
  PERCENTAGE
}

// A vendor's self-managed coverage circles, replacing the old flat
// DEFAULT_RADIUS_KM broadcast radius. Live-call eligibility checks whether
// any of a vendor's areas covers the call's location (see
// getNearbyLiveCallsForVendorAction) — a vendor with zero rows here
// receives zero calls by design, so every vendor gets one auto-seeded row
// at creation time (see createVendorAction / completeVendorOnboarding).
model VendorServiceArea {
  id        String        @id @default(cuid())
  vendorId  String
  vendor    VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  pincode   String
  latitude  Float
  longitude Float
  // Vendor-adjustable per area. 15 mirrors the old flat radius and is used
  // only for the one-time backfill/auto-seed rows; a vendor's own later
  // additions default their form input to 5.
  radiusKm  Float         @default(5)
  createdAt DateTime      @default(now())

  @@unique([vendorId, pincode])
  @@index([vendorId])
}

enum TechnicianType {
  FREELANCE
  VENDOR_MANAGED
}

model TechnicianProfile {
  id              String         @id @default(cuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            TechnicianType @default(FREELANCE)
  skillCategory   String
  experienceYears Int
  aadhaarNumber   String?
  // Courtesy display field only ("where do you generally work") — no longer
  // collected at creation/onboarding and never used for job matching, which
  // is now live-location-based (see TechnicianLocation + VendorServiceArea).
  // Nullable rather than dropped: existing rows and a handful of display
  // sites still read it.
  servicePincode  String?
  // Set only for technicians a vendor creates from their own dashboard — not
  // part of the public self-signup flow this schema currently supports.
  vendorId        String?
  vendor          VendorProfile? @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  serviceCalls    ServiceCall[]
  serviceCallOffers ServiceCallOffer[]
  location        TechnicianLocation?
  locationEvents  TechnicianLocationEvent[]
  // Broad ("I do everything in this category") and narrow ("I only do this
  // specific service") skill assignment — independent of each other, not
  // nested. A technician's real offered set is the union of both; see
  // technicianOffersAnyService in src/lib/technicianSkills.ts, the one place
  // that union is resolved.
  categories      TechnicianCategory[]
  offeredServices TechnicianService[]
  reviews         Review[]
  // Denormalised from Review on every write. The storefront and the
  // customer's tracking screen both show these on load, so they can't be a
  // live AVG() join per render.
  ratingAvg       Float?
  ratingCount     Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

enum OtpChannel {
  SMS
  WHATSAPP
}

enum OtpPurpose {
  CUSTOMER_LOGIN
  TECHNICIAN_LOGIN
}

// Codes we generate and verify ourselves — ApiTxt (or any provider) is only
// ever used as a delivery pipe for the `codeHash`'d value. Deliberately not
// tied to a User row via FK: a customer OTP send happens before any account
// exists for that phone yet.
model OtpCode {
  id         String     @id @default(cuid())
  phone      String
  channel    OtpChannel
  purpose    OtpPurpose
  codeHash   String
  attempts   Int        @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime   @default(now())

  @@index([phone, purpose, createdAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Storefront taxonomy. Drives the homepage category grid, the popular-services
// slider tabs, the /services filter tabs and the footer links — previously all
// five of those were separate hardcoded lists that drifted apart.
model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  // Iconify name (e.g. "ph:broom"). Rendered icon-only on /services tabs.
  icon        String?
  // Tile photo for the homepage grid, which shows an image with an icon pill
  // overlaid — hence both fields rather than one.
  image       String?
  isActive    Boolean   @default(true)
  isPopular   Boolean   @default(false)
  sortOrder   Int       @default(0)
  services    Service[]
  technicianCategories TechnicianCategory[]
  vendorCategories     VendorCategory[]
  couponScopes         CouponScope[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Broad technician skill assignment — "does everything in this category."
// See TechnicianService for the narrower per-service alternative, and
// technicianOffersAnyService (src/lib/technicianSkills.ts) for how the two
// combine. Replaces the old free-text, unconstrained TechnicianProfile.skillCategory.
model TechnicianCategory {
  id           String            @id @default(cuid())
  technicianId String
  technician   TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  categoryId   String
  category     Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now())

  @@unique([technicianId, categoryId])
  @@index([categoryId])
}

// Narrow technician skill assignment — "does only this specific service,"
// independent of (not nested inside) any TechnicianCategory row. A
// technician can have this without the parent category assigned at all.
model TechnicianService {
  id           String            @id @default(cuid())
  technicianId String
  technician   TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  serviceId    String
  service      Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now())

  @@unique([technicianId, serviceId])
  @@index([serviceId])
}

// Which categories a vendor may serve — admin-assigned, not self-managed.
// A vendor with zero rows here sees zero live calls by design (see
// getNearbyLiveCallsForVendorAction); a vendor wanting more raises a
// SupportTicket instead of self-granting access.
model VendorCategory {
  id         String        @id @default(cuid())
  vendorId   String
  vendor     VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())

  @@unique([vendorId, categoryId])
  @@index([categoryId])
}

model Service {
  id          String    @id @default(cuid())
  // Live aggregate from Review. The admin-entered `rating` display string
  // below stays as the fallback while ratingCount is 0, so nothing goes
  // blank before the first review lands.
  ratingAvg   Float?
  ratingCount Int       @default(0)
  slug        String    @unique
  title       String
  // Nullable so deleting a category degrades gracefully (SetNull) rather than
  // blocking at the DB layer — the app-level guard in category.actions.ts is
  // what actually refuses a delete while services are still attached.
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  badge       String?
  badgeColor  String?
  rating      String?
  isPopular   Boolean   @default(false)
  image       String
  videoUrl    String?
  time        String?
  warranty    String?
  description String    @db.Text
  benefits    Json?
  howItWorks  Json?
  faqs        Json?
  packages    ServicePackage[]
  technicianServices TechnicianService[]
  couponScopes       CouponScope[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([categoryId])
}

model ServicePackage {
  id            String     @id @default(cuid())
  serviceId     String
  service       Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name          String
  price         Float
  originalPrice Float
  time          String?
  category      String?
  tag           String?
  rating        String?
  image         String?
  features      Json
  details       Json?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  cartItems     CartItem[]
  liveCallItems LiveCallItem[]
  couponScopes  CouponScope[]

  @@index([serviceId])
}

enum CartItemStatus {
  ACTIVE
  SAVED
}

model CartItem {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId String
  package   ServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  quantity  Int            @default(1)
  status    CartItemStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([userId, packageId])
  @@index([userId, status])
}

enum LiveCallStatus {
  // Order created (cart snapshotted, address captured) but online payment
  // hasn't been confirmed yet — invisible to every vendor/admin match query.
  // Never used for COD, which still goes straight to BROADCASTING.
  AWAITING_PAYMENT
  BROADCASTING
  ACCEPTED
  CONVERTED
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  COD
  // Set when a customer cancels an already-PAID online order — flags it for
  // an admin to process the actual refund manually via the Razorpay
  // dashboard (refunds are deliberately not automated yet).
  REFUND_PENDING
  REFUNDED
}

enum ServiceCallStatus {
  // A vendor has accepted the order but no technician has taken it yet —
  // the job exists and is visible to everyone, it just has no owner. Every
  // job now starts here, including when technicians were on duty at accept
  // time (they just move it to ASSIGNED within seconds).
  UNASSIGNED
  ASSIGNED
  EN_ROUTE
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Outcome the technician records on the completion report — a job can be
// finished, paused pending something (see ServiceReport.holdReason), or
// need a second visit.
enum ServiceCompletionStatus {
  COMPLETED
  ON_HOLD
  REVISIT_REQUIRED
}

enum NotificationType {
  NEW_LIVE_CALL
  CALL_ACCEPTED
  CALL_ASSIGNED
  CALL_STATUS_UPDATE
  JOB_OFFER
  JOB_UNASSIGNED
  NEW_MESSAGE
  SUPPORT_TICKET_CREATED
  SUPPORT_TICKET_MESSAGE
  SUPPORT_TICKET_RESOLVED
  CALL_CANCELLED
}

enum ServiceCallOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

// Created when a customer completes checkout. Broadcast (by proximity) to
// nearby vendors until one accepts and assigns a technician, at which point
// it converts into a ServiceCall. Customer contact fields are snapshotted
// here rather than joined from User, so vendors/technicians always see the
// details as they were at order time even if the customer edits their
// profile later.
model LiveCall {
  id                  String          @id @default(cuid())
  customerId          String
  customer            User            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerName        String
  customerPhone       String
  // Optional alternate contact for when the booking is on behalf of someone
  // else and the technician should call a different number/person at the
  // site instead of the customer. Plain free-text order metadata —
  // deliberately unrelated to and not validated against User.phone (that
  // column is unique and used for OTP account lookup; this one is not
  // unique and has no auth role).
  siteContactName     String?
  siteContactPhone    String?
  customerEmail       String
  address             String
  city                String
  state               String
  pincode             String
  latitude            Float
  longitude           Float
  // Null means "as soon as possible" — the customer picked the Instant
  // option at checkout rather than a scheduled slot.
  scheduledFor        DateTime?
  // "ONLINE" or "COD" for new orders. Historical orders predate this split
  // and hold one of the six old self-reported UPI-app labels instead
  // (e.g. "gpay") — every consumer must treat this as free text, not an enum.
  paymentMode         String
  // Set only when paymentMode is "ADMIN" (created via the admin panel,
  // single or bulk) — the specific admin's name, snapshotted at creation
  // time so it stays accurate even if that admin later renames their own
  // profile, same reasoning as customerName being snapshotted rather than
  // joined live.
  createdByAdminName  String?
  // Per-order job PINs, set only for admin-created live calls (single or
  // bulk). When present these override the customer's own fixed
  // startPin/completionPin (see User.startPin) for this one order — admin
  // orders often use an auto-provisioned or unfamiliar customer account, so
  // a random per-order code the admin can hand off directly (rather than the
  // account's permanent PIN) is what actually gets used on-site. Generated
  // from a letters+digits alphabet (see src/lib/pins.ts) specifically so
  // they never collide in form with a real customer's plain-numeric PIN.
  startPin            String?
  completionPin       String?
  // Short, human-readable, chronological order reference (displayed as
  // "HZ-100234" via src/lib/ticketNumber.ts) — for on-site verification,
  // handover context, and vendor ticket-number search. Backfilled by hand
  // (see the one-off backfill script run alongside this migration) rather
  // than left to a plain `db push`, since a freshly-added autoincrement
  // column would assign values in physical row order, not createdAt order,
  // which would make old orders' ticket numbers read out of sequence.
  ticketSeq           Int             @default(autoincrement()) @unique
  // Superseded by razorpayPaymentId for online orders. Nullable because COD
  // and online orders never collect a customer-typed reference.
  upiRef              String?
  // Optional — checkout no longer requires a manual payment-proof upload.
  // Every consumer of this field must treat it as possibly absent.
  paymentScreenshotUrl String?
  // Null means "predates payment-status tracking" (historical order).
  paymentStatus       PaymentStatus?
  // Idempotency key shared by the client-return verify call and the webhook
  // — whichever gets there first wins via a conditional updateMany claim.
  razorpayOrderId     String?         @unique
  razorpayPaymentId   String?
  subtotal            Float
  tax                 Float
  total               Float
  // How much of this order's total was covered by the customer's wallet
  // balance (Amazon-Pay-style optional apply-at-checkout). For the online
  // path this is debited immediately at order-creation time (reserved), not
  // at payment confirmation — if the order is abandoned and this row
  // expires from AWAITING_PAYMENT, the sweep refunds it back. COD/wallet-only
  // orders never sit in AWAITING_PAYMENT, so there's no reservation window
  // to worry about there.
  walletAmountApplied Float           @default(0)
  couponCode          String?
  discountAmount      Float           @default(0)
  // The total as the customer originally paid it. Written once, the first
  // time a vendor edits the job's items, so a revised price can always be
  // shown against what was actually charged instead of silently replacing
  // it. Null means the job has never been edited.
  originalTotal       Float?
  status              LiveCallStatus  @default(BROADCASTING)
  acceptedByVendorId  String?
  acceptedByVendor    VendorProfile?  @relation(fields: [acceptedByVendorId], references: [id], onDelete: SetNull)
  acceptedAt          DateTime?
  // Set only by cancelMyOrderAction — the customer's self-service cancel
  // while the order is still unclaimed (BROADCASTING). Once a vendor has
  // accepted, cancellation goes through the ServiceCall's own status flow
  // instead.
  cancelReason        String?
  cancelledAt         DateTime?
  // No longer used to auto-expire BROADCASTING orders — a paid order
  // vanishing into a refund after a timeout is a business cost, not a
  // technical cleanliness win. Still used to expire AWAITING_PAYMENT rows,
  // where nothing has been charged yet.
  expiresAt           DateTime?
  items               LiveCallItem[]
  serviceCall         ServiceCall?
  offers              ServiceCallOffer[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([status])
  @@index([customerId])
}

// Snapshot of a cart line item at the moment the LiveCall was created —
// packageId is nullable/SetNull so a later ServicePackage deletion never
// breaks historical order records.
model LiveCallItem {
  id          String          @id @default(cuid())
  liveCallId  String
  liveCall    LiveCall        @relation(fields: [liveCallId], references: [id], onDelete: Cascade)
  packageId   String?
  package     ServicePackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  packageName String
  unitPrice   Float
  quantity    Int

  @@index([liveCallId])
}

// The execution record once a vendor accepts a LiveCall and assigns a
// technician — one-to-one with the LiveCall it was converted from.
model ServiceCall {
  id            String             @id @default(cuid())
  liveCallId    String             @unique
  liveCall      LiveCall           @relation(fields: [liveCallId], references: [id], onDelete: Cascade)
  vendorId      String
  vendor        VendorProfile      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  // Null while UNASSIGNED. SetNull rather than Cascade so deleting a
  // technician orphans the job back to the vendor instead of destroying
  // the customer's order history along with it.
  technicianId  String?
  technician    TechnicianProfile? @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  customerId    String
  customer      User               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status        ServiceCallStatus  @default(UNASSIGNED)
  // Set the moment a technician claims the job; cleared again if they
  // decline it back into the pool.
  assignedAt    DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?
  // Failed customer-PIN entries at the start/complete gates. Locks the
  // gate at PIN_MAX_ATTEMPTS until the owning vendor resets it — a fixed
  // 4-digit PIN is only 10k combinations, so this is what stops it being
  // brute-forced.
  pinAttempts   Int                @default(0)
  // Where the technician's device reported itself at each gate, recorded
  // even when the check passes (and even while GEOFENCE_ENFORCED is off —
  // during the warn-only rollout these columns ARE the experiment, the
  // evidence for whether 150m is achievable in the field). Keeping the fix
  // alongside the computed distance also makes a spoofed position
  // reviewable after the fact rather than invisible.
  startLatitude        Float?
  startLongitude       Float?
  startAccuracyM       Float?
  startDistanceM       Float?
  completeLatitude     Float?
  completeLongitude    Float?
  completeAccuracyM    Float?
  completeDistanceM    Float?
  // Per-job escape hatch for a technician the fence wrongly blocks —
  // typically an order whose address geocoded to a city centroid, where the
  // required distance is unachievable by construction. Vendor (own job) or
  // admin may set it.
  geofenceBypass       Boolean   @default(false)
  geofenceBypassBy     String?
  geofenceBypassReason String?
  geofenceBypassAt     DateTime?
  // A single overwritable "in transit" slot, not a list — set by
  // declineJobAction and reassignServiceCallAction's freelancer branch (the
  // two paths that null out technicianId while a predecessor existed), and
  // consumed (copied into a ServiceCallHandover row, then cleared) by
  // claimServiceCallAction — the only path that sets technicianId from
  // null. Correctly collapses across multi-hop decline/reassign chains
  // since it's only ever overwritten, never appended, until consumed.
  previousTechnicianId     String?
  previousTechnicianName   String?
  previousHandoverReason   String?
  handovers     ServiceCallHandover[]
  photos        JobPhoto[]
  signature     JobSignature?
  report        ServiceReport?
  review        Review?
  messages      ChatMessage[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([vendorId])
  @@index([technicianId])
  @@index([customerId])
  @@index([status])
}

// Append-only log of completed handovers — written once the NEW
// technician's assignment is actually final (own-staff: immediately in
// reassignServiceCallAction; freelancer: in claimServiceCallAction on
// accept), so the new technician can see who had this job before them and
// why, without needing a live join back through User/TechnicianProfile
// rows that may since have changed or been deleted.
model ServiceCallHandover {
  id                 String      @id @default(cuid())
  serviceCallId      String
  serviceCall        ServiceCall @relation(fields: [serviceCallId], references: [id], onDelete: Cascade)
  fromTechnicianId   String?
  fromTechnicianName String
  toTechnicianId     String
  toTechnicianName   String
  reason             String?
  createdAt          DateTime    @default(now())

  @@index([serviceCallId])
  @@index([toTechnicianId])
}

enum JobPhotoPhase {
  BEFORE
  AFTER
}

// Optional site photos the technician takes at each gate — "before" when
// starting, "after" when finishing. Rows are written the moment each upload
// succeeds rather than being collected and submitted with the PIN, so a
// technician who loses signal part-way through never loses the photos they
// already sent.
model JobPhoto {
  id            String        @id @default(cuid())
  serviceCallId String
  serviceCall   ServiceCall   @relation(fields: [serviceCallId], references: [id], onDelete: Cascade)
  phase         JobPhotoPhase
  /// What the app renders — an /api/files/... path, deliberately not a
  /// provider hostname, so migrating buckets never orphans these rows.
  url           String
  /// Provider-side key, kept alongside the URL so deletes and server-side
  /// reads (PDF embedding) never have to parse a URL back into a key.
  storageKey    String
  contentType   String
  sizeBytes     Int
  /// Snapshot — the technician may later be unassigned from this job.
  uploadedById  String?
  uploadedAt    DateTime      @default(now())

  @@index([serviceCallId, phase])
}

// The customer's signature, drawn on the technician's phone at completion.
// Optional: a customer who won't sign doesn't block the job, and the
// generated documents fall back to a PIN-verified acknowledgement line.
model JobSignature {
  id            String      @id @default(cuid())
  serviceCallId String      @unique
  serviceCall   ServiceCall @relation(fields: [serviceCallId], references: [id], onDelete: Cascade)
  url           String
  storageKey    String
  /// Who actually signed — often not the account holder, so it's captured
  /// rather than assumed from the order.
  signerName    String
  signedAt      DateTime    @default(now())
}

// The technician's closing paperwork, submitted alongside the completion
// PIN. One per job.
model ServiceReport {
  id               String                  @id @default(cuid())
  serviceCallId    String                  @unique
  serviceCall      ServiceCall             @relation(fields: [serviceCallId], references: [id], onDelete: Cascade)
  completionStatus ServiceCompletionStatus
  // Free text backed by a fixed picklist in the UI — kept as a string so
  // adding a reason never needs a migration.
  holdReason       String?
  newVisitAt       DateTime?
  remarks          String
  submittedAt      DateTime                @default(now())
}

// What the customer thought, once. Two scores per job: the technician who
// did the work, and the job itself — kept separate so a good technician
// isn't dragged down by a service they didn't design.
model Review {
  id                String      @id @default(cuid())
  serviceCallId     String      @unique
  serviceCall       ServiceCall @relation(fields: [serviceCallId], references: [id], onDelete: Cascade)
  customerId        String
  customer          User        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // Null if the technician was later removed — the review still counts
  // toward the service.
  technicianId      String?
  technician        TechnicianProfile? @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  vendorId          String
  technicianRating  Int
  technicianComment String?
  serviceRating     Int
  serviceComment    String?
  // Every Service this job covered, so per-service aggregates can be
  // recomputed without walking items -> package -> service each time.
  serviceIds        String[]
  createdAt         DateTime    @default(now())

  @@index([technicianId])
  @@index([vendorId])
  @@index([customerId])
}

// One thread per job, between the customer and whichever technician holds
// it. The owning vendor can read it too, for support.
model ChatMessage {
  id            String      @id @default(cuid())
  serviceCallId String
  serviceCall   ServiceCall @relation(fields: [serviceCallId], references: [id], onDelete: Cascade)
  senderId      String
  sender        User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body          String
  readAt        DateTime?
  createdAt     DateTime    @default(now())

  @@index([serviceCallId, createdAt])
}

enum SupportTicketCategory {
  SERVICE_AREA
  CATEGORY_ACCESS
  GENERAL
}

enum SupportTicketStatus {
  OPEN
  RESOLVED
  CLOSED
}

enum SupportContactType {
  PHONE
  EMAIL
}

// A platform-level list of admin-configured contact numbers/emails — not
// tied to any one SUPER_ADMIN account. A vendor who'd rather just call or
// email than raise a SupportTicket sees this list on /vendor/support.
model SupportContact {
  id        String             @id @default(cuid())
  type      SupportContactType
  // e.g. "Billing", "Technical", "General" — shown above the value.
  label     String
  value     String
  sortOrder Int                @default(0)
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([isActive, sortOrder])
}

// A vendor's request to the platform — most concretely, "give me this
// service area" or "give me access to this category" now that both are
// admin-managed rather than vendor-self-service. The two actionable
// categories carry structured fields so an admin can approve with one click
// (creating the real VendorServiceArea/VendorCategory row) instead of
// parsing free text; GENERAL tickets are plain support requests. The
// conversation itself lives in SupportTicketMessage — this row is only the
// ticket's metadata, mirroring how ServiceCall/ChatMessage split job
// metadata from its conversation.
model SupportTicket {
  id                   String                @id @default(cuid())
  vendorId             String
  vendor               VendorProfile         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category             SupportTicketCategory
  subject              String
  requestedPincode     String?
  requestedRadiusKm    Float?
  requestedCategoryIds String[]
  status               SupportTicketStatus   @default(OPEN)
  messages             SupportTicketMessage[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  resolvedAt           DateTime?

  @@index([vendorId, status])
}

model SupportTicketMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
}

// A single technician's offer for a LiveCall a vendor has accepted. A vendor
// "Accept" broadcasts one PENDING row per eligible on-duty technician instead
// of directly creating a ServiceCall — the ServiceCall itself is only ever
// created once one technician actually accepts their offer (see
// acceptJobOfferAction), at which point the sibling offers for the same
// liveCallId are bulk-flipped to EXPIRED. PENDING rows past a short TTL are
// lazily swept to EXPIRED whenever queried (same idiom as LiveCall.expiresAt
// — no cron/background job exists in this stack).
model ServiceCallOffer {
  id           String                  @id @default(cuid())
  liveCallId   String
  liveCall     LiveCall                @relation(fields: [liveCallId], references: [id], onDelete: Cascade)
  vendorId     String
  vendor       VendorProfile           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  technicianId String
  technician   TechnicianProfile       @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  status       ServiceCallOfferStatus  @default(PENDING)
  // Why the technician turned it down — surfaced to the vendor so they can
  // see whether it's a coverage problem or a job problem.
  declineReason String?
  createdAt    DateTime                @default(now())
  respondedAt  DateTime?

  @@unique([liveCallId, technicianId])
  @@index([technicianId, status])
  @@index([liveCallId])
}

model Notification {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          NotificationType
  title         String
  message       String
  liveCallId    String?
  serviceCallId String?
  isRead        Boolean          @default(false)
  createdAt     DateTime         @default(now())

  @@index([userId, isRead])
}

// One row per technician, upserted — keeps high-frequency position writes
// off the TechnicianProfile row itself. isOnDuty lets a vendor's live map
// grey out a marker instead of removing it when a technician clocks off.
model TechnicianLocation {
  id           String            @id @default(cuid())
  technicianId String            @unique
  technician   TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  latitude     Float
  longitude    Float
  isOnDuty     Boolean           @default(false)
  updatedAt    DateTime          @updatedAt
}

enum TechnicianLocationEventType {
  PING
  DUTY_ON
  DUTY_OFF
}

// Append-only history — deliberately separate from TechnicianLocation above,
// which stays a single overwritten row driving the fast live-tracking map
// unchanged. PING rows are throttled independently at the write site
// (updateTechnicianLocationAction) to roughly one per 90s/150m of travel, not
// one per live-tracking write, so a full on-duty day is ~300 rows, not
// thousands. DUTY_ON/DUTY_OFF are always logged (infrequent) and are what
// let a timeline be reconstructed from first clock-in to last clock-out.
model TechnicianLocationEvent {
  id           String                      @id @default(cuid())
  technicianId String
  technician   TechnicianProfile           @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  eventType    TechnicianLocationEventType
  latitude     Float
  longitude    Float
  createdAt    DateTime                    @default(now())

  @@index([technicianId, createdAt])
}

// --- Wallets ---
// Deposit-only ledgers. Vendors fund theirs via Razorpay and spend it buying
// live-call leads; customers only ever have theirs credited (a cancelled/
// unfulfilled paid order's refund) or debited by applying it at checkout —
// neither wallet supports a cash-out/withdraw action by design.
//
// Kept as two separate models rather than one polymorphic "Wallet" table:
// a vendor wallet only ever sees DEPOSIT/DEBIT, a customer wallet only ever
// sees REFUND/REDEEM — the transaction shapes don't overlap, and this
// codebase already prefers explicit models over generic ones.

enum WalletTransactionType {
  DEPOSIT // vendor funding their wallet via Razorpay
  DEBIT // vendor spending balance to buy a lead
  REFUND // customer wallet credited from a cancelled/unfulfilled paid order
  REDEEM // customer wallet balance applied at checkout
}

enum WalletTransactionStatus {
  PENDING // Razorpay order created, not yet confirmed (DEPOSIT only)
  COMPLETED
  FAILED
}

model VendorWallet {
  id           String                     @id @default(cuid())
  vendorId     String                     @unique
  vendor       VendorProfile              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  balance      Float                      @default(0)
  transactions VendorWalletTransaction[]
  updatedAt    DateTime                   @updatedAt
}

model VendorWalletTransaction {
  id       String                   @id @default(cuid())
  walletId String
  wallet   VendorWallet             @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type     WalletTransactionType
  status   WalletTransactionStatus @default(COMPLETED)
  amount   Float
  // Set only for DEPOSIT — the idempotency key the client-return call and
  // the Razorpay webhook both key off, same pattern as LiveCall.razorpayOrderId.
  razorpayOrderId   String? @unique
  razorpayPaymentId String?
  // Set only for DEBIT — which lead this spend bought.
  liveCallId String?
  // Both set only for an admin-initiated manual credit (recharging a
  // vendor's wallet directly, e.g. cash received outside the app) — adminName
  // is the specific admin's name (snapshotted, so it survives their own
  // later profile renames) and adminNote is their free-text reason.
  adminName  String?
  adminNote  String?
  createdAt  DateTime @default(now())

  @@index([walletId])
}

model CustomerWallet {
  id           String                       @id @default(cuid())
  userId       String                       @unique
  user         User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance      Float                        @default(0)
  transactions CustomerWalletTransaction[]
  updatedAt    DateTime                     @updatedAt
}

model CustomerWalletTransaction {
  id       String   @id @default(cuid())
  walletId String
  wallet   CustomerWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type     WalletTransactionType // REFUND | REDEEM
  amount   Float
  // The order this credit came from (REFUND) or was spent on (REDEEM).
  liveCallId String?
  createdAt  DateTime @default(now())

  @@index([walletId])
}

// --- Coupons ---
enum CouponDiscountType {
  FLAT
  PERCENTAGE
}

enum CouponScopeType {
  ALL // every service/package is eligible
  SPECIFIC // only what's listed in CouponScope rows
}

model Coupon {
  id            String             @id @default(cuid())
  code          String             @unique
  description   String?
  discountType  CouponDiscountType
  discountValue Float
  scopeType     CouponScopeType    @default(ALL)
  scopes        CouponScope[]
  // Null on either side means "no restriction on that side" — e.g. startsAt
  // null + endsAt set means "active immediately, until endsAt".
  startsAt      DateTime?
  endsAt        DateTime?
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

// One row per eligible target — a coupon can mix categories/services/
// packages at once. Ignored entirely when Coupon.scopeType is ALL.
model CouponScope {
  id         String          @id @default(cuid())
  couponId   String
  coupon     Coupon          @relation(fields: [couponId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category?       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  serviceId  String?
  service    Service?        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  packageId  String?
  package    ServicePackage? @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([couponId])
}
