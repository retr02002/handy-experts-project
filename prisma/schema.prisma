generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  PENDING
  CUSTOMER
  TECHNICIAN
  VENDOR
  SUPER_ADMIN
}

model User {
  id                String             @id @default(cuid())
  name              String?
  email             String?            @unique
  emailVerified     DateTime?
  image             String?
  password          String?
  // Globally unique across every role — OTP login looks accounts up by
  // phone, so a phone number can only ever belong to one account, whichever
  // role it registered under first.
  phone             String?            @unique
  // Technician-only login handle (self-chosen at signup, or auto-generated
  // when a vendor creates the account). Null for every other role.
  username          String?            @unique
  role              Role               @default(PENDING)
  // Customer-only: two fixed 4-digit PINs the customer reads out — one to
  // let a technician start a job, a different one to let them close it, so
  // knowing the start PIN never lets anyone mark work complete. Generated
  // lazily on their first order. Never sent to a technician's device — they
  // submit a candidate and the server compares.
  startPin          String?
  completionPin     String?
  accounts          Account[]
  sessions          Session[]
  cartItems         CartItem[]
  vendorProfile     VendorProfile?
  technicianProfile TechnicianProfile?
  liveCalls         LiveCall[]
  serviceCalls      ServiceCall[]
  notifications     Notification[]
  addresses         Address[]
  chatMessages      ChatMessage[]
  reviews           Review[]
}

// A customer's saved delivery location — Blinkit/Zomato-style address book.
// Not referenced by a foreign key from LiveCall: checkout snapshots the
// chosen address's fields into LiveCall directly (same pattern already used
// for customer contact fields), so editing/deleting a saved address here
// never changes a past order's record.
model Address {
  id          String   @id @default(cuid())
  customerId  String
  customer    User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // Free text, customer-chosen — "Home"/"Work"/"Other" are just quick-pick
  // suggestions in the UI, not an enum.
  label       String
  addressLine String
  city        String
  state       String
  pincode     String
  latitude    Float
  longitude   Float
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([customerId])
}

// Company type is a free-form string (not an enum) so new legal structures
// don't require a schema migration — the onboarding form offers a fixed
// dropdown of common values, but the column itself stays flexible.
model VendorProfile {
  id                String              @id @default(cuid())
  userId            String              @unique
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName       String
  companyType       String
  // Optional at onboarding — a vendor can start operating and add these
  // later. No @unique on any of the three, so relaxing to nullable is a
  // pure widening with no migration hazard.
  gstNumber         String?
  panNumber         String?
  aadhaarNumber     String?
  address           String
  city              String
  state             String
  pincode           String
  // Business location — captured via "use current location" at onboarding.
  // Nullable because vendors who onboarded before this field existed won't
  // have it set; matching logic must treat null as "not yet locatable".
  latitude          Float?
  longitude         Float?
  // Deactivated vendors keep their account and history intact but stop
  // receiving new live-call broadcasts — the safe alternative to deleting a
  // vendor outright, which would cascade-delete their ServiceCall history.
  isActive          Boolean             @default(true)
  incorporationDate DateTime
  technicians       TechnicianProfile[]
  liveCallsAccepted LiveCall[]
  serviceCalls      ServiceCall[]
  serviceCallOffers ServiceCallOffer[]
  serviceAreas      VendorServiceArea[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

// A vendor's self-managed coverage circles, replacing the old flat
// DEFAULT_RADIUS_KM broadcast radius. Live-call eligibility checks whether
// any of a vendor's areas covers the call's location (see
// getNearbyLiveCallsForVendorAction) — a vendor with zero rows here
// receives zero calls by design, so every vendor gets one auto-seeded row
// at creation time (see createVendorAction / completeVendorOnboarding).
model VendorServiceArea {
  id        String        @id @default(cuid())
  vendorId  String
  vendor    VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  pincode   String
  latitude  Float
  longitude Float
  // Vendor-adjustable per area. 15 mirrors the old flat radius and is used
  // only for the one-time backfill/auto-seed rows; a vendor's own later
  // additions default their form input to 5.
  radiusKm  Float         @default(5)
  createdAt DateTime      @default(now())

  @@unique([vendorId, pincode])
  @@index([vendorId])
}

enum TechnicianType {
  FREELANCE
  VENDOR_MANAGED
}

model TechnicianProfile {
  id              String         @id @default(cuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            TechnicianType @default(FREELANCE)
  skillCategory   String
  experienceYears Int
  aadhaarNumber   String?
  servicePincode  String
  // Set only for technicians a vendor creates from their own dashboard — not
  // part of the public self-signup flow this schema currently supports.
  vendorId        String?
  vendor          VendorProfile? @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  serviceCalls    ServiceCall[]
  serviceCallOffers ServiceCallOffer[]
  location        TechnicianLocation?
  serviceAreas    TechnicianServiceArea[]
  reviews         Review[]
  // Denormalised from Review on every write. The storefront and the
  // customer's tracking screen both show these on load, so they can't be a
  // live AVG() join per render.
  ratingAvg       Float?
  ratingCount     Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

// Mirrors VendorServiceArea — informational/visual coverage circles a
// technician self-manages. Unlike the vendor version, these do NOT gate any
// matching logic today (job assignment to technicians is still manual);
// they exist so a vendor/admin can see each technician's declared coverage
// on the live-calls map.
model TechnicianServiceArea {
  id           String            @id @default(cuid())
  technicianId String
  technician   TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  pincode      String
  latitude     Float
  longitude    Float
  radiusKm     Float             @default(5)
  createdAt    DateTime          @default(now())

  @@unique([technicianId, pincode])
  @@index([technicianId])
}

enum OtpChannel {
  SMS
  WHATSAPP
}

enum OtpPurpose {
  CUSTOMER_LOGIN
  TECHNICIAN_LOGIN
}

// Codes we generate and verify ourselves — ApiTxt (or any provider) is only
// ever used as a delivery pipe for the `codeHash`'d value. Deliberately not
// tied to a User row via FK: a customer OTP send happens before any account
// exists for that phone yet.
model OtpCode {
  id         String     @id @default(cuid())
  phone      String
  channel    OtpChannel
  purpose    OtpPurpose
  codeHash   String
  attempts   Int        @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime   @default(now())

  @@index([phone, purpose, createdAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Storefront taxonomy. Drives the homepage category grid, the popular-services
// slider tabs, the /services filter tabs and the footer links — previously all
// five of those were separate hardcoded lists that drifted apart.
model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  // Iconify name (e.g. "ph:broom"). Rendered icon-only on /services tabs.
  icon        String?
  // Tile photo for the homepage grid, which shows an image with an icon pill
  // overlaid — hence both fields rather than one.
  image       String?
  isActive    Boolean   @default(true)
  isPopular   Boolean   @default(false)
  sortOrder   Int       @default(0)
  services    Service[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Service {
  id          String    @id @default(cuid())
  // Live aggregate from Review. The admin-entered `rating` display string
  // below stays as the fallback while ratingCount is 0, so nothing goes
  // blank before the first review lands.
  ratingAvg   Float?
  ratingCount Int       @default(0)
  slug        String    @unique
  title       String
  // Nullable so deleting a category degrades gracefully (SetNull) rather than
  // blocking at the DB layer — the app-level guard in category.actions.ts is
  // what actually refuses a delete while services are still attached.
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  badge       String?
  badgeColor  String?
  rating      String?
  isPopular   Boolean   @default(false)
  image       String
  videoUrl    String?
  time        String?
  warranty    String?
  description String    @db.Text
  benefits    Json?
  howItWorks  Json?
  faqs        Json?
  packages    ServicePackage[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([categoryId])
}

model ServicePackage {
  id            String     @id @default(cuid())
  serviceId     String
  service       Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name          String
  price         Float
  originalPrice Float
  time          String?
  category      String?
  tag           String?
  rating        String?
  image         String?
  features      Json
  details       Json?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  cartItems     CartItem[]
  liveCallItems LiveCallItem[]

  @@index([serviceId])
}

enum CartItemStatus {
  ACTIVE
  SAVED
}

model CartItem {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId String
  package   ServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  quantity  Int            @default(1)
  status    CartItemStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([userId, packageId])
  @@index([userId, status])
}

enum LiveCallStatus {
  BROADCASTING
  ACCEPTED
  CONVERTED
  EXPIRED
  CANCELLED
}

enum ServiceCallStatus {
  // A vendor has accepted the order but no technician has taken it yet —
  // the job exists and is visible to everyone, it just has no owner. Every
  // job now starts here, including when technicians were on duty at accept
  // time (they just move it to ASSIGNED within seconds).
  UNASSIGNED
  ASSIGNED
  EN_ROUTE
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Outcome the technician records on the completion report — a job can be
// finished, paused pending something (see ServiceReport.holdReason), or
// need a second visit.
enum ServiceCompletionStatus {
  COMPLETED
  ON_HOLD
  REVISIT_REQUIRED
}

enum NotificationType {
  NEW_LIVE_CALL
  CALL_ACCEPTED
  CALL_ASSIGNED
  CALL_STATUS_UPDATE
  JOB_OFFER
  JOB_UNASSIGNED
  NEW_MESSAGE
}

enum ServiceCallOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

// Created when a customer completes checkout. Broadcast (by proximity) to
// nearby vendors until one accepts and assigns a technician, at which point
// it converts into a ServiceCall. Customer contact fields are snapshotted
// here rather than joined from User, so vendors/technicians always see the
// details as they were at order time even if the customer edits their
// profile later.
model LiveCall {
  id                  String          @id @default(cuid())
  customerId          String
  customer            User            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerName        String
  customerPhone       String
  // Optional alternate contact for when the booking is on behalf of someone
  // else and the technician should call a different number/person at the
  // site instead of the customer. Plain free-text order metadata —
  // deliberately unrelated to and not validated against User.phone (that
  // column is unique and used for OTP account lookup; this one is not
  // unique and has no auth role).
  siteContactName     String?
  siteContactPhone    String?
  customerEmail       String
  address             String
  city                String
  state               String
  pincode             String
  latitude            Float
  longitude           Float
  // Null means "as soon as possible" — the customer picked the Instant
  // option at checkout rather than a scheduled slot.
  scheduledFor        DateTime?
  paymentMode         String
  upiRef              String
  // Optional — checkout no longer requires a manual payment-proof upload.
  // Every consumer of this field must treat it as possibly absent.
  paymentScreenshotUrl String?
  subtotal            Float
  tax                 Float
  total               Float
  status              LiveCallStatus  @default(BROADCASTING)
  acceptedByVendorId  String?
  acceptedByVendor    VendorProfile?  @relation(fields: [acceptedByVendorId], references: [id], onDelete: SetNull)
  acceptedAt          DateTime?
  expiresAt           DateTime?
  items               LiveCallItem[]
  serviceCall         ServiceCall?
  offers              ServiceCallOffer[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([status])
  @@index([customerId])
}

// Snapshot of a cart line item at the moment the LiveCall was created —
// packageId is nullable/SetNull so a later ServicePackage deletion never
// breaks historical order records.
model LiveCallItem {
  id          String          @id @default(cuid())
  liveCallId  String
  liveCall    LiveCall        @relation(fields: [liveCallId], references: [id], onDelete: Cascade)
  packageId   String?
  package     ServicePackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  packageName String
  unitPrice   Float
  quantity    Int

  @@index([liveCallId])
}

// The execution record once a vendor accepts a LiveCall and assigns a
// technician — one-to-one with the LiveCall it was converted from.
model ServiceCall {
  id            String             @id @default(cuid())
  liveCallId    String             @unique
  liveCall      LiveCall           @relation(fields: [liveCallId], references: [id], onDelete: Cascade)
  vendorId      String
  vendor        VendorProfile      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  // Null while UNASSIGNED. SetNull rather than Cascade so deleting a
  // technician orphans the job back to the vendor instead of destroying
  // the customer's order history along with it.
  technicianId  String?
  technician    TechnicianProfile? @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  customerId    String
  customer      User               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status        ServiceCallStatus  @default(UNASSIGNED)
  // Set the moment a technician claims the job; cleared again if they
  // decline it back into the pool.
  assignedAt    DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?
  // Failed customer-PIN entries at the start/complete gates. Locks the
  // gate at PIN_MAX_ATTEMPTS until the owning vendor resets it — a fixed
  // 4-digit PIN is only 10k combinations, so this is what stops it being
  // brute-forced.
  pinAttempts   Int                @default(0)
  report        ServiceReport?
  review        Review?
  messages      ChatMessage[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([vendorId])
  @@index([technicianId])
  @@index([customerId])
  @@index([status])
}

// The technician's closing paperwork, submitted alongside the completion
// PIN. One per job.
model ServiceReport {
  id               String                  @id @default(cuid())
  serviceCallId    String                  @unique
  serviceCall      ServiceCall             @relation(fields: [serviceCallId], references: [id], onDelete: Cascade)
  completionStatus ServiceCompletionStatus
  // Free text backed by a fixed picklist in the UI — kept as a string so
  // adding a reason never needs a migration.
  holdReason       String?
  newVisitAt       DateTime?
  remarks          String
  submittedAt      DateTime                @default(now())
}

// What the customer thought, once. Two scores per job: the technician who
// did the work, and the job itself — kept separate so a good technician
// isn't dragged down by a service they didn't design.
model Review {
  id                String      @id @default(cuid())
  serviceCallId     String      @unique
  serviceCall       ServiceCall @relation(fields: [serviceCallId], references: [id], onDelete: Cascade)
  customerId        String
  customer          User        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // Null if the technician was later removed — the review still counts
  // toward the service.
  technicianId      String?
  technician        TechnicianProfile? @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  vendorId          String
  technicianRating  Int
  technicianComment String?
  serviceRating     Int
  serviceComment    String?
  // Every Service this job covered, so per-service aggregates can be
  // recomputed without walking items -> package -> service each time.
  serviceIds        String[]
  createdAt         DateTime    @default(now())

  @@index([technicianId])
  @@index([vendorId])
  @@index([customerId])
}

// One thread per job, between the customer and whichever technician holds
// it. The owning vendor can read it too, for support.
model ChatMessage {
  id            String      @id @default(cuid())
  serviceCallId String
  serviceCall   ServiceCall @relation(fields: [serviceCallId], references: [id], onDelete: Cascade)
  senderId      String
  sender        User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body          String
  readAt        DateTime?
  createdAt     DateTime    @default(now())

  @@index([serviceCallId, createdAt])
}

// A single technician's offer for a LiveCall a vendor has accepted. A vendor
// "Accept" broadcasts one PENDING row per eligible on-duty technician instead
// of directly creating a ServiceCall — the ServiceCall itself is only ever
// created once one technician actually accepts their offer (see
// acceptJobOfferAction), at which point the sibling offers for the same
// liveCallId are bulk-flipped to EXPIRED. PENDING rows past a short TTL are
// lazily swept to EXPIRED whenever queried (same idiom as LiveCall.expiresAt
// — no cron/background job exists in this stack).
model ServiceCallOffer {
  id           String                  @id @default(cuid())
  liveCallId   String
  liveCall     LiveCall                @relation(fields: [liveCallId], references: [id], onDelete: Cascade)
  vendorId     String
  vendor       VendorProfile           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  technicianId String
  technician   TechnicianProfile       @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  status       ServiceCallOfferStatus  @default(PENDING)
  // Why the technician turned it down — surfaced to the vendor so they can
  // see whether it's a coverage problem or a job problem.
  declineReason String?
  createdAt    DateTime                @default(now())
  respondedAt  DateTime?

  @@unique([liveCallId, technicianId])
  @@index([technicianId, status])
  @@index([liveCallId])
}

model Notification {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          NotificationType
  title         String
  message       String
  liveCallId    String?
  serviceCallId String?
  isRead        Boolean          @default(false)
  createdAt     DateTime         @default(now())

  @@index([userId, isRead])
}

// One row per technician, upserted — keeps high-frequency position writes
// off the TechnicianProfile row itself. isOnDuty lets a vendor's live map
// grey out a marker instead of removing it when a technician clocks off.
model TechnicianLocation {
  id           String            @id @default(cuid())
  technicianId String            @unique
  technician   TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  latitude     Float
  longitude    Float
  isOnDuty     Boolean           @default(false)
  updatedAt    DateTime          @updatedAt
}
