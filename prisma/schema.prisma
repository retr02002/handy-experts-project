generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  PENDING
  CUSTOMER
  TECHNICIAN
  VENDOR
  SUPER_ADMIN
}

model User {
  id                String             @id @default(cuid())
  name              String?
  email             String?            @unique
  emailVerified     DateTime?
  image             String?
  password          String?
  phone             String?
  role              Role               @default(PENDING)
  accounts          Account[]
  sessions          Session[]
  cartItems         CartItem[]
  vendorProfile     VendorProfile?
  technicianProfile TechnicianProfile?
  liveCalls         LiveCall[]
  serviceCalls      ServiceCall[]
  notifications     Notification[]
}

// Company type is a free-form string (not an enum) so new legal structures
// don't require a schema migration — the onboarding form offers a fixed
// dropdown of common values, but the column itself stays flexible.
model VendorProfile {
  id                String              @id @default(cuid())
  userId            String              @unique
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName       String
  companyType       String
  gstNumber         String
  panNumber         String
  aadhaarNumber     String
  address           String
  city              String
  state             String
  pincode           String
  // Business location — captured via "use current location" at onboarding.
  // Nullable because vendors who onboarded before this field existed won't
  // have it set; matching logic must treat null as "not yet locatable".
  latitude          Float?
  longitude         Float?
  incorporationDate DateTime
  technicians       TechnicianProfile[]
  liveCallsAccepted LiveCall[]
  serviceCalls      ServiceCall[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

enum TechnicianType {
  FREELANCE
  VENDOR_MANAGED
}

model TechnicianProfile {
  id              String         @id @default(cuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            TechnicianType @default(FREELANCE)
  skillCategory   String
  experienceYears Int
  aadhaarNumber   String?
  servicePincode  String
  // Set only for technicians a vendor creates from their own dashboard — not
  // part of the public self-signup flow this schema currently supports.
  vendorId        String?
  vendor          VendorProfile? @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  serviceCalls    ServiceCall[]
  location        TechnicianLocation?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Service {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  category    String
  badge       String?
  badgeColor  String?
  rating      String?
  image       String
  videoUrl    String?
  time        String?
  warranty    String?
  description String    @db.Text
  benefits    Json?
  howItWorks  Json?
  faqs        Json?
  packages    ServicePackage[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ServicePackage {
  id            String     @id @default(cuid())
  serviceId     String
  service       Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name          String
  price         Float
  originalPrice Float
  time          String?
  category      String?
  tag           String?
  rating        String?
  image         String?
  features      Json
  details       Json?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  cartItems     CartItem[]
  liveCallItems LiveCallItem[]

  @@index([serviceId])
}

enum CartItemStatus {
  ACTIVE
  SAVED
}

model CartItem {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId String
  package   ServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  quantity  Int            @default(1)
  status    CartItemStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([userId, packageId])
  @@index([userId, status])
}

enum LiveCallStatus {
  BROADCASTING
  ACCEPTED
  CONVERTED
  EXPIRED
  CANCELLED
}

enum ServiceCallStatus {
  ASSIGNED
  EN_ROUTE
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum NotificationType {
  NEW_LIVE_CALL
  CALL_ACCEPTED
  CALL_ASSIGNED
  CALL_STATUS_UPDATE
}

// Created when a customer completes checkout. Broadcast (by proximity) to
// nearby vendors until one accepts and assigns a technician, at which point
// it converts into a ServiceCall. Customer contact fields are snapshotted
// here rather than joined from User, so vendors/technicians always see the
// details as they were at order time even if the customer edits their
// profile later.
model LiveCall {
  id                  String          @id @default(cuid())
  customerId          String
  customer            User            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerName        String
  customerPhone       String
  customerEmail       String
  address             String
  city                String
  state               String
  pincode             String
  latitude            Float
  longitude           Float
  paymentMode         String
  upiRef              String
  paymentScreenshotUrl String
  subtotal            Float
  tax                 Float
  total               Float
  status              LiveCallStatus  @default(BROADCASTING)
  acceptedByVendorId  String?
  acceptedByVendor    VendorProfile?  @relation(fields: [acceptedByVendorId], references: [id], onDelete: SetNull)
  acceptedAt          DateTime?
  expiresAt           DateTime?
  items               LiveCallItem[]
  serviceCall         ServiceCall?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([status])
  @@index([customerId])
}

// Snapshot of a cart line item at the moment the LiveCall was created —
// packageId is nullable/SetNull so a later ServicePackage deletion never
// breaks historical order records.
model LiveCallItem {
  id          String          @id @default(cuid())
  liveCallId  String
  liveCall    LiveCall        @relation(fields: [liveCallId], references: [id], onDelete: Cascade)
  packageId   String?
  package     ServicePackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  packageName String
  unitPrice   Float
  quantity    Int

  @@index([liveCallId])
}

// The execution record once a vendor accepts a LiveCall and assigns a
// technician — one-to-one with the LiveCall it was converted from.
model ServiceCall {
  id            String            @id @default(cuid())
  liveCallId    String            @unique
  liveCall      LiveCall          @relation(fields: [liveCallId], references: [id], onDelete: Cascade)
  vendorId      String
  vendor        VendorProfile     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  technicianId  String
  technician    TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  customerId    String
  customer      User              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status        ServiceCallStatus @default(ASSIGNED)
  assignedAt    DateTime          @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([vendorId])
  @@index([technicianId])
  @@index([customerId])
}

model Notification {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          NotificationType
  title         String
  message       String
  liveCallId    String?
  serviceCallId String?
  isRead        Boolean          @default(false)
  createdAt     DateTime         @default(now())

  @@index([userId, isRead])
}

// One row per technician, upserted — keeps high-frequency position writes
// off the TechnicianProfile row itself. isOnDuty lets a vendor's live map
// grey out a marker instead of removing it when a technician clocks off.
model TechnicianLocation {
  id           String            @id @default(cuid())
  technicianId String            @unique
  technician   TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  latitude     Float
  longitude    Float
  isOnDuty     Boolean           @default(false)
  updatedAt    DateTime          @updatedAt
}
