generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  PENDING
  CUSTOMER
  TECHNICIAN
  VENDOR
  SUPER_ADMIN
}

model User {
  id                String             @id @default(cuid())
  name              String?
  email             String?            @unique
  emailVerified     DateTime?
  image             String?
  password          String?
  phone             String?
  role              Role               @default(PENDING)
  accounts          Account[]
  sessions          Session[]
  cartItems         CartItem[]
  vendorProfile     VendorProfile?
  technicianProfile TechnicianProfile?
}

// Company type is a free-form string (not an enum) so new legal structures
// don't require a schema migration — the onboarding form offers a fixed
// dropdown of common values, but the column itself stays flexible.
model VendorProfile {
  id                String              @id @default(cuid())
  userId            String              @unique
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName       String
  companyType       String
  gstNumber         String
  panNumber         String
  aadhaarNumber     String
  address           String
  city              String
  state             String
  pincode           String
  incorporationDate DateTime
  technicians       TechnicianProfile[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

enum TechnicianType {
  FREELANCE
  VENDOR_MANAGED
}

model TechnicianProfile {
  id              String         @id @default(cuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            TechnicianType @default(FREELANCE)
  skillCategory   String
  experienceYears Int
  aadhaarNumber   String?
  servicePincode  String
  // Set only for technicians a vendor creates from their own dashboard — not
  // part of the public self-signup flow this schema currently supports.
  vendorId        String?
  vendor          VendorProfile? @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Service {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  category    String
  badge       String?
  badgeColor  String?
  rating      String?
  image       String
  videoUrl    String?
  time        String?
  warranty    String?
  description String    @db.Text
  benefits    Json?
  howItWorks  Json?
  faqs        Json?
  packages    ServicePackage[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ServicePackage {
  id            String     @id @default(cuid())
  serviceId     String
  service       Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name          String
  price         Float
  originalPrice Float
  time          String?
  category      String?
  tag           String?
  rating        String?
  image         String?
  features      Json
  details       Json?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  cartItems     CartItem[]

  @@index([serviceId])
}

enum CartItemStatus {
  ACTIVE
  SAVED
}

model CartItem {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId String
  package   ServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  quantity  Int            @default(1)
  status    CartItemStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([userId, packageId])
  @@index([userId, status])
}
